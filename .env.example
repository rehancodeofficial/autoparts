# ==============================================
# Environment Configuration — AutoPart KSA
# ==============================================

NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16 — local OR Supabase cloud)
# For local development:  postgresql://autopart_user:autopart_password@localhost:5432/autopart_db?schema=public
# For Supabase production: use the "Connection string" from your Supabase dashboard → Settings → Database
DATABASE_URL=postgresql://autopart_user:autopart_password@localhost:5432/autopart_db?schema=public

# Supabase (required for production on Vercel)
# Find these in your Supabase dashboard → Settings → API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Optional if DATABASE_URL is set directly; otherwise used to build pooler connection
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_POOLER_REGION=ap-northeast-1

# Supabase (frontend — exposed to the browser via Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth & Secrets
JWT_ACCESS_SECRET=dev_super_secret_access_jwt_key_32chars
JWT_REFRESH_SECRET=dev_super_secret_refresh_jwt_key_32chars
JWT_ACCESS_TTL=900 # 15 minutes in seconds
JWT_REFRESH_TTL=604800 # 7 days in seconds

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=autopart-assets

# ----------------------------------------------------------------------------
# Payments
# ----------------------------------------------------------------------------
# MOCK   — self-contained test gateway. No network, no charges. Default.
# MOYASAR— hosted invoice page (mada, Visa/Mastercard, Apple Pay, STC Pay).
PAYMENT_GATEWAY_PROVIDER=MOCK

# Signs the MOCK driver's payment references and webhook payloads so a client
# cannot forge a "paid" callback. Any random string; required in production.
PAYMENT_MOCK_SECRET=change_me_in_production

# MOCK only: the outcome every test payment takes (paid | failed | cancelled | pending)
MOCK_PAYMENT_OUTCOME=paid

# Moyasar (only when PAYMENT_GATEWAY_PROVIDER=MOYASAR)
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Absolute origin the payment provider redirects the shopper back to.
# Leave blank to derive it from the incoming request.
PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Admin account bootstrap
# ----------------------------------------------------------------------------
# The admin panel signs in against the User table. These seed that account.
# A default password is REFUSED when NODE_ENV=production — set your own.
ADMIN_USERNAME=demoadmin
ADMIN_PASSWORD=demoadmin
ADMIN_ROLE=SUPER_ADMIN

# ----------------------------------------------------------------------------
# Store pricing (all amounts in integer halalas: 1 SAR = 100 halalas)
# ----------------------------------------------------------------------------
STORE_FREE_SHIPPING_THRESHOLD_HALALAS=50000
STORE_FLAT_SHIPPING_HALALAS=2500

# Scratch database for the integration test suite (pnpm test).
TEST_DATABASE_URL=postgresql://autopart_user:autopart_password@localhost:5432/autopart_test

# Store Configuration
STORE_VAT_PERCENT=15
STORE_RESERVATION_TTL_MINUTES=15
STORE_SELLER_VAT_NUMBER=300000000000003
STORE_DEFAULT_CURRENCY=SAR
