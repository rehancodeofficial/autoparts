# ==============================================
# Environment Configuration — AutoPart KSA
# ==============================================

NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16 — local OR Supabase cloud)
# For local development:  postgresql://autopart_user:autopart_password@localhost:5432/autopart_db?schema=public
# For Supabase production: use the "Connection string" from your Supabase dashboard → Settings → Database
DATABASE_URL=postgresql://autopart_user:autopart_password@localhost:5432/autopart_db?schema=public

# Supabase (required for production on Vercel)
# Find these in your Supabase dashboard → Settings → API
