# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth & Secrets
JWT_ACCESS_SECRET=dev_super_secret_access_jwt_key_32chars
JWT_REFRESH_SECRET=dev_super_secret_refresh_jwt_key_32chars
JWT_ACCESS_TTL=900 # 15 minutes in seconds
JWT_REFRESH_TTL=604800 # 7 days in seconds

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=autopart-assets

# Payments
PAYMENT_GATEWAY_PROVIDER=MOCK # MOCK | TAP | HYPERPAY
TAP_SECRET_KEY=sk_test_placeholder_key
TAP_PUBLIC_KEY=pk_test_placeholder_key
TAMARA_API_KEY=tamara_test_placeholder_key
TAMARA_NOTIFICATION_TOKEN=tamara_secret_notification_token

# Store Configuration
STORE_VAT_PERCENT=15
STORE_RESERVATION_TTL_MINUTES=15
STORE_SELLER_VAT_NUMBER=300000000000003
STORE_DEFAULT_CURRENCY=SAR
